#!/bin/sh
set -eu
sbph_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sbph_command=${1:-doctor}
if [ "$#" -gt 0 ]; then shift; fi
case "$sbph_command" in
  motion-register)
    export PYTHONPATH="$sbph_dir/src${PYTHONPATH:+:$PYTHONPATH}"
    exec "$sbph_dir/.venv/bin/python" -m sbph.motion_registration "$@"
    ;;
  motion-use)
    export PYTHONPATH="$sbph_dir/src${PYTHONPATH:+:$PYTHONPATH}"
    exec "$sbph_dir/.venv/bin/python" -m sbph.unit9_run use "$sbph_dir" "$@"
    ;;
  motion-finish)
    exec "$sbph_dir/scripts/unit9-finish.sh" "$@"
    ;;
  motion-status|motion-resume|motion-note|motion-notes|motion-resolve|motion-reanchor|motion-intent|motion-check|motion-shots|motion-validate|motion-timeline|motion-assemble|motion-package|motion-preflight|motion-evidence|motion-screen-record|motion-conform)
    export PYTHONPATH="$sbph_dir/src${PYTHONPATH:+:$PYTHONPATH}"
    if [ "${1:-}" = --run ]; then
      if [ "$#" -lt 2 ]; then
        echo "unit9: --run needs an existing run name" >&2
        exit 1
      fi
      sbph_native_config=$("$sbph_dir/.venv/bin/python" -m sbph.unit9_run config "$sbph_dir" "$2")
      shift 2
    else
      sbph_native_config=$("$sbph_dir/.venv/bin/python" -m sbph.unit9_run config "$sbph_dir")
    fi
    exec "$sbph_dir/sbph" "${sbph_command#motion-}" "$sbph_native_config" "$@"
    ;;
esac
exec "$sbph_dir/sbph" "$sbph_command" "$sbph_dir/examples/unit-9.json" "$@"
